{
  "name": "@poutine/hub",
  "version": "0.5.7",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint": "eslint src/",
    "lint:boundary": "eslint --config eslint.boundary.config.js src/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.2",
    "@fastify/static": "^10.1.10",
    "better-sqlite3": "^13.1.1",
    "fast-uri": "^3.1.9",
    "fast-xml-parser": "^5.12.0",
    "fastify": "^5.12.8",
    "jose": "^6.2.17",
    "newrelic": "^14.12.0",
    "pino": "^9.14.0",
    "sharp": "^0.35.5",
    "undici": "^7.30.2",
    "yaml": "^2.9.1",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.6.6",
    "@types/yazl": "^3.3.1",
    "eslint": "^9.39.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.1.12"
  }
}
